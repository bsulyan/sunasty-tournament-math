  "files": [
    "index.js",
    "index.d.ts",
    "presets.js",
    "engine.js",
    "simulate.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test.js"
  },
  "keywords": [
    "tournament",
    "swiss",
    "tcg",
    "mtg",
    "pokemon",
    "yugioh",
    "lorcana",
    "one-piece",
    "flesh-and-blood",
    "tiebreaker",
    "omw",
    "top-cut",
    "bracket"
  ],
  "author": "Sunasty <https://sunasty.com>",
