{
  "name": "swiss-math",
  "version": "1.0.0",
  "description": "Zero-dependency Swiss tournament structure calculator, official TCG preset tables (Magic, Pokemon, Yu-Gi-Oh, Lorcana, One Piece, Flesh & Blood), bracket builder, and Monte-Carlo tiebreaker simulator.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
